# ============================================================================
# MarketPulse AI & Personal AI — Unified Configuration
# ============================================================================

# Operating Environment & Mode
ENVIRONMENT=development
OPERATING_MODE=desktop
LOG_LEVEL=INFO
LOG_DIR=logs

# MarketPulse AI Storage & Paths (Port 8001)
DATABASE_URL=sqlite:///data/marketpulse.db
ARTIFACTS_DIR=artifacts
DATA_DIR=data

# MarketPulse API Server
API_HOST=127.0.0.1
API_PORT=8001
API_SECRET_KEY=marketpulse-default-dev-secret-change-me
MARKETPULSE_BASE_URL=http://127.0.0.1:8001

# AI Model Inference Configuration
DEFAULT_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cloud AI Provider (Optional for Cloud Mode)
# CLOUD_API_KEY=your_openai_or_anthropic_api_key_here
# CLOUD_API_BASE=https://api.openai.com/v1
# CLOUD_MODEL=gpt-4o-mini

# n8n Workflow Automation Engine
N8N_ENABLED=true
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_API_KEY=
N8N_WEBHOOK_SECRET=your_shared_webhook_secret_here
N8N_TIMEOUT_SECONDS=10.0
N8N_MAX_RETRIES=3

# Cloudflare Access Service Token (Optional for Zero Trust Tunnels)
# CLOUDFLARE_ACCESS_CLIENT_ID=your_cf_access_client_id
# CLOUDFLARE_ACCESS_CLIENT_SECRET=your_cf_access_client_secret

# Personal AI Base Automation Server (Port 8000)
PERSONAL_AI_API_PORT=8000
APPROVAL_MODE=safe
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
CLIPBOARD_MONITORING_ENABLED=false

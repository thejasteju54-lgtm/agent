# Personal AI Automation System Configuration

# Environment & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_DIR=logs

# Storage & Paths
DATABASE_PATH=data/personal_ai.db
ARTIFACTS_DIR=artifacts

# Security & Approvals
# Modes: safe (requires approval for medium/high risk), strict (approval for all), auto (approval for high risk only)
APPROVAL_MODE=safe

# AI Model Configuration
DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cloud AI Provider (Optional)
# CLOUD_API_PROVIDER=openai_compatible
# CLOUD_API_KEY=your_api_key_here
# CLOUD_API_BASE=https://api.openai.com/v1
# CLOUD_MODEL=gpt-4o-mini

# Browser Automation
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000

# Clipboard History
CLIPBOARD_MONITORING_ENABLED=false
CLIPBOARD_POLL_INTERVAL_SEC=1.0

# API / Integration Server
API_HOST=127.0.0.1
API_PORT=8000
API_AUTH_TOKEN=change_this_to_a_secure_token_in_production

# n8n & Webhooks
WEBHOOK_API_KEY=change_this_to_a_secure_webhook_key_in_production
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_PATH=/webhook/personal-ai


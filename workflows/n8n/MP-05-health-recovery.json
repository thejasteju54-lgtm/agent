{
  "name": "MP-05 Health and Failure Recovery",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "node-interval-05",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8001/api/v1/health",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "node-health-check-05",
      "name": "Check Backend Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.statusCode || 200 }}",
              "operation": "equal",
              "value2": 200
            }
          ]
        }
      },
      "id": "node-if-healthy-05",
      "name": "Evaluate Health Response",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return {\n  system_status: 'HEALTHY',\n  checked_at: new Date().toISOString(),\n  details: $json\n};"
      },
      "id": "node-log-healthy-05",
      "name": "Log Health Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const err = $json;\nreturn {\n  system_status: 'DEGRADED',\n  alert: 'MarketPulse AI backend unreachable or returning errors',\n  error_details: err.message || err,\n  detected_at: new Date().toISOString()\n};"
      },
      "id": "node-alert-degraded-05",
      "name": "Alert Degraded State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        380
      ]
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Check Backend Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Backend Health": {
      "main": [
        [
          {
            "node": "Evaluate Health Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate Health Response": {
      "main": [
        [
          {
            "node": "Log Health Status",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Alert Degraded State",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    "marketpulse",
    "health",
    "recovery"
  ]
}

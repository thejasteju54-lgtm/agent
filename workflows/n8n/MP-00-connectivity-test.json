{
  "name": "MP-00 Connectivity Test",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "marketpulse-test",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-1",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "webhookId": "marketpulse-test-webhook"
    },
    {
      "parameters": {
        "jsCode": "const input = $json;\nreturn {\n  status: 'success',\n  correlation_id: input.correlation_id || 'unspecified',\n  received_at: input.triggered_at || new Date().toISOString(),\n  processed_at: new Date().toISOString(),\n  system: 'MarketPulse AI',\n  echo: input\n};"
      },
      "id": "node-code-1",
      "name": "Process Test Echo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node-respond-1",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        700,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Process Test Echo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Test Echo": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    "marketpulse",
    "test",
    "connectivity"
  ]
}
